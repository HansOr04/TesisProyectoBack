{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Pruebas de mutación: cambia el código a propósito y verifica que las pruebas unitarias lo detecten. El CI corre un objetivo por trabajo (matriz) con --mutate.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "enableFindRelatedTests": true },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": 50 },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4
}
