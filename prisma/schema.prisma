generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String    @id // slug legible, p.ej. "demo" — se usa como `:org` en las rutas
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name String

  createdById String?
  createdBy   User?   @relation("OrganisationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members      OrganisationMember[]
  userRoles    AuthUserRole[]
  activityLogs ActivityLog[]

  assessmentProfiles    AssessmentOrganisationProfile[]
  assessmentTemplates   AssessmentTemplate[]
  assessmentEvaluations AssessmentEvaluation[]
  indicatorMeasures     AssessmentIndicatorMeasure[]
  riskCountryParams     AssessmentRiskCountryParam[]

  @@index([createdById])
}

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  email        String  @unique
  passwordHash String?
  name         String?
  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  oauthProvider String?
  oauthSubject  String?

  memberships          OrganisationMember[]
  userRoles            AuthUserRole[]
  createdOrganisations Organisation[]       @relation("OrganisationCreator")
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]

  @@unique([oauthProvider, oauthSubject])
}

model RefreshToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  @@index([userId])
  @@index([familyId])
}

model OrganisationMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model AppModule {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  code        String  @unique // "assessment-core", "organizational-tool", ...
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  permissions AppModulePermission[]

  @@index([code])
}

model AppModulePermission {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  moduleId String
  module   AppModule @relation(fields: [moduleId], references: [id])

  code        String // "read", "write", "delete", "admin"
  name        String
  description String?

  rolePermissions AuthRolePermission[]

  @@unique([moduleId, code])
  @@index([moduleId])
}

model AuthRole {
  id           String    @id @default(cuid())
  organisation String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  code        String
  name        String
  description String?
  isSystem    Boolean @default(false)
  sortOrder   Int     @default(0)

  permissions AuthRolePermission[]
  userRoles   AuthUserRole[]

  @@unique([organisation, code])
  @@index([organisation])
  @@index([code])
}

model AuthRolePermission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  roleId String
  role   AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   AppModulePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedBy String?

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuthUserRole {
  id           String       @id @default(cuid())
  organisation String
  org          Organisation @relation(fields: [organisation], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedBy        String?
  customPermissions Json?

  @@unique([organisation, userId, roleId])
  @@index([organisation])
  @@index([userId])
  @@index([roleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  organisation String
  org          Organisation @relation(fields: [organisation], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])

  type        String // p.ej. "assessment-evaluation.complete"
  note        String
  level       String @default("INFO")
  sourceType  String @default("UI")
  dataPreview Json
  data        Json

  ipAddress String?
  userAgent String?
  requestId String?

  @@index([organisation, type, createdAt])
  @@index([organisation, level, createdAt])
  @@index([createdAt])
}

enum AssessmentTool {
  ORGANIZATIONAL
  CAPACITY
  RISK
}

enum AssessmentEvaluationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AssessmentRiskClass {
  NEGLIGIBLE
  NON_NEGLIGIBLE
}

enum AssessmentMeasureStatus {
  PENDING // "por ejecutar"  (avance = 0%)
  IN_PROGRESS // "en ejecución"  (1–99%)
  DONE // "concluido"     (100%)
}

model AssessmentOrganisationProfile {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation      String
  organisationRef   Organisation @relation(fields: [organisation], references: [id])
  name              String
  tradeName         String?
  type              String // "ASSOCIATION" | "COMPANY"
  associationLevel  String?
  country           String
  region            String?
  yearStarted       Int?
  memberCount       Int?
  mainActivity      String? // actividad principal (p.ej. "Exportación de cacao...")
  mainProduct       String // "cacao" | "café" | otro
  secondaryProducts String?
  certifications    String?
  mainMarkets       String?
  legalRep          String?
  contactEmail      String?
  contactPhone      String?
  evaluatorId       String?
  confidential      Boolean      @default(false)

  parentProfileId String?
  parentProfile   AssessmentOrganisationProfile?  @relation("AssessmentProfileHierarchy", fields: [parentProfileId], references: [id])
  childProfiles   AssessmentOrganisationProfile[] @relation("AssessmentProfileHierarchy")

  evaluations         AssessmentEvaluation[]
  sectionExclusions   AssessmentProfileSectionExclusion[]
  indicatorExclusions AssessmentProfileIndicatorExclusion[]

  @@unique([organisation, name])
  @@index([organisation])
  @@index([evaluatorId])
  @@index([parentProfileId])
}

model AssessmentRiskCountryParam {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation    String
  organisationRef Organisation @relation(fields: [organisation], references: [id])
  country         String // ISO 3166-1 alpha-2, p.ej. "EC"
  riskThreshold   Decimal
  updatedBy       String?

  @@unique([organisation, country])
}

model AssessmentTemplate {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation    String
  organisationRef Organisation   @relation(fields: [organisation], references: [id])
  tool            AssessmentTool
  version         Int            @default(1)
  name            String
  description     String?
  active          Boolean        @default(true)
  labels          Json?
  createdBy       String?

  riskThreshold Decimal? @default(5)

  sections    AssessmentSection[]
  evaluations AssessmentEvaluation[]

  @@unique([organisation, tool, version])
  @@index([organisation, tool])
}

model AssessmentSection {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  number      Int // "número" del RF-03/04/05
  name        String
  description String?
  weight      Decimal @default(1)
  sortOrder   Int     @default(0)

  indicators AssessmentIndicator[]
  exclusions AssessmentProfileSectionExclusion[]

  @@unique([templateId, number])
  @@index([templateId])
}

model AssessmentIndicator {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sectionId String
  section   AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  code          String // p.ej. "A-1.3" — estable para paridad con Excel
  name          String
  description   String?
  helpText      String?
  scoringRubric String?
  weight        Decimal @default(1)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  responses         AssessmentResponse[]
  indicatorMeasures AssessmentIndicatorMeasure[]
  exclusions        AssessmentProfileIndicatorExclusion[]

  @@unique([sectionId, code])
  @@index([sectionId])
}

model AssessmentProfileSectionExclusion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  createdBy String

  profileId String
  profile   AssessmentOrganisationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sectionId String
  section   AssessmentSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([profileId, sectionId])
  @@index([profileId])
}

model AssessmentProfileIndicatorExclusion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  createdBy String

  profileId   String
  profile     AssessmentOrganisationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  indicatorId String
  indicator   AssessmentIndicator           @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([profileId, indicatorId])
  @@index([profileId])
}

model AssessmentEvaluation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation    String
  organisationRef Organisation                  @relation(fields: [organisation], references: [id])
  templateId      String
  template        AssessmentTemplate            @relation(fields: [templateId], references: [id])
  profileId       String
  profile         AssessmentOrganisationProfile @relation(fields: [profileId], references: [id])

  status      AssessmentEvaluationStatus @default(DRAFT)
  startedBy   String
  startedAt   DateTime                   @default(now())
  completedAt DateTime?

  globalScore      Decimal?
  sectionScores    Json?
  executiveSummary String?

  responses         AssessmentResponse[]
  risks             AssessmentRisk[]
  indicatorMeasures AssessmentIndicatorMeasure[]

  @@index([organisation])
  @@index([profileId])
  @@index([templateId])
  @@index([organisation, status, updatedAt])
}

model AssessmentResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationId String
  evaluation   AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  indicatorId  String
  indicator    AssessmentIndicator  @relation(fields: [indicatorId], references: [id])

  score          Int
  observation    String
  isCritical     Boolean  @default(false)
  manualCritical Boolean  @default(false)
  scoredBy       String
  scoredAt       DateTime @default(now())

  @@unique([evaluationId, indicatorId])
  @@index([evaluationId])
  @@index([evaluationId, isCritical])
}

model AssessmentRisk {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationId String
  evaluation   AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  indicatorId  String

  description  String
  riskType     String?
  class        AssessmentRiskClass
  identifiedBy String

  measures AssessmentMitigationMeasure[]

  @@unique([evaluationId, indicatorId])
  @@index([evaluationId])
}

model AssessmentMitigationMeasure {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  riskId String
  risk   AssessmentRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  description         String
  responsible         String
  support             String? // "apoyo" — persona/rol de soporte al responsable
  startWeek           DateTime
  durationDays        Int
  endDate             DateTime
  resources           String?
  budgetUsd           Decimal? // "inversión ($ USD)" estimada para la medida
  verificationLink    String? // "medios de verificación" — enlace/evidencia de cumplimiento
  progressPct         Int                     @default(0)
  status              AssessmentMeasureStatus @default(PENDING)
  expectedResult      String?
  appliedImprovements String?
  updatedBy           String

  @@index([riskId])
}

model AssessmentIndicatorMeasure {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation    String
  organisationRef Organisation @relation(fields: [organisation], references: [id])

  evaluationId String
  evaluation   AssessmentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  indicatorId  String
  indicator    AssessmentIndicator  @relation(fields: [indicatorId], references: [id])

  name                String
  description         String?
  responsible         String
  support             String? // "apoyo" — persona/rol de soporte al responsable
  startDate           DateTime
  endDate             DateTime
  budgetUsd           Decimal? // "inversión ($ USD)" estimada para la medida
  verificationLink    String? // "medios de verificación" — enlace/evidencia de cumplimiento
  progressPct         Int                     @default(0)
  status              AssessmentMeasureStatus @default(PENDING)
  expectedResult      String?
  appliedImprovements String?
  updatedBy           String

  @@index([evaluationId])
  @@index([indicatorId])
}

model AssessmentAiCache {
  key        String   @id
  provider   String
  model      String?
  text       String
  tokensUsed Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
