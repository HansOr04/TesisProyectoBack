# ── Servidor ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
CORS_ORIGIN=http://localhost:5173

# ── Base de datos (docker-compose levanta postgres en el puerto 5434) ────
DATABASE_URL=postgresql://assessment:assessment@localhost:5434/assessment?schema=public

# ── Autenticación propia (JWT) ───────────────────────────────────────────
JWT_SECRET=cambia-este-secreto-en-produccion
# Token de acceso corto; la sesión se renueva con el refresh token (cookie HttpOnly)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Meses que se conserva la auditoría (purga diaria a las 03:00)
ACTIVITY_LOG_RETENTION_MONTHS=24

# ── OAuth Google (opcional, gratis). Si está vacío, el login con Google se desactiva.
GOOGLE_OAUTH_CLIENT_ID=

# ── IA (gemini | nvidia). Sin key, los endpoints de IA responden 503. ────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Seed ─────────────────────────────────────────────────────────────────
SEED_ORGANISATION_ID=demo
SEED_ORGANISATION_NAME=Organización Demo
SEED_ADMIN_EMAIL=admin@evaluacion.local
SEED_ADMIN_PASSWORD=admin123
SEED_EVALUATOR_EMAIL=evaluador@evaluacion.local
SEED_EVALUATOR_PASSWORD=evaluador123

# Exportes PPTX/Excel generados a la vez (el resto espera en cola, máx. 20)
EXPORT_MAX_CONCURRENCY=2
EXPORT_MAX_QUEUED=20
